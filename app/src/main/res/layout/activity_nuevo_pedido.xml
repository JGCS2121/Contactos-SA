<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/wa_green"
            app:titleTextColor="@color/white"
            app:title="Nuevo Pedido" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLIENTE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:layout_marginBottom="4dp"/>
            <AutoCompleteTextView
                android:id="@+id/actv_cliente"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Escribe el nombre del cliente"
                android:background="@color/surface_container_low"
                android:paddingHorizontal="12dp"
                android:completionThreshold="1"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESCRIPCIÓN DEL PEDIDO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/et_descripcion"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Ej: Vestido rojo talla M"
                android:background="@color/surface_container_low"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FECHA Y HORA DE ENTREGA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:layout_marginBottom="4dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <Button
                    android:id="@+id/btn_fecha"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="Seleccionar fecha"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/surface_container_low"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:id="@+id/btn_hora"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="Seleccionar hora"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/surface_container_low" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECORDATORIOS AUTOMÁTICOS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:layout_marginBottom="4dp"/>
            <CheckBox
                android:id="@+id/cb_recordatorio_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Avisar 1 día antes"
                android:checked="true"/>
            <CheckBox
                android:id="@+id/cb_recordatorio_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Avisar 2 horas antes"
                android:checked="true"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTAS ADICIONALES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/et_notas"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Anticipo recibido, dirección, etc."
                android:background="@color/surface_container_low"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btn_guardar_pedido"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💾 Guardar pedido"
                android:textSize="16sp"
                android:backgroundTint="@color/wa_green"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_cancelar_pedido"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🗑️ Cancelar"
                android:backgroundTint="@color/surface_container_low"
                android:textColor="@color/text_primary"/>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
