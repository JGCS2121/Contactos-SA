<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/wa_green"
            android:title="📢 Campaña Masiva"
            android:titleTextColor="@color/white"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ① Mensaje con variaciones -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_container_low">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✏️  Mensaje"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Añade variaciones con {opción1|opción2|opción3} para que cada mensaje sea único."
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="10dp"/>

                    <EditText
                        android:id="@+id/et_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="120dp"
                        android:gravity="top"
                        android:hint="¡{Hola|Hey|Buenas}! Mira nuestras {ofertas|novedades} {🔥|✨}"
                        android:inputType="textMultiLine|textCapSentences"
                        android:background="@android:color/transparent"
                        android:textSize="14sp"
                        android:padding="4dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/text_secondary"
                        android:alpha="0.2"
                        android:layout_marginVertical="8dp"/>

                    <!-- Vista previa spintax -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Vista previa:"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary"/>

                        <Button
                            android:id="@+id/btn_preview"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="🔀 Nueva"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            style="@style/Widget.Material3.Button.TonalButton"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="(Escribe el mensaje para ver la vista previa)"
                        android:textSize="13sp"
                        android:textColor="@color/wa_green"
                        android:fontFamily="monospace"
                        android:layout_marginTop="6dp"
                        android:padding="8dp"
                        android:background="@color/surface_container_low"/>

                    <TextView
                        android:id="@+id/tv_combinations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ② Hora de inicio -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_container_low">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕐  Hora de inicio"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp"/>

                    <RadioGroup
                        android:id="@+id/rg_start_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_start_now"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Ahora mismo"
                            android:checked="true"/>

                        <RadioButton
                            android:id="@+id/rb_start_scheduled"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Programar hora"/>
                    </RadioGroup>

                    <Button
                        android:id="@+id/btn_pick_time"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🕑 Seleccionar hora de inicio"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                    <TextView
                        android:id="@+id/tv_scheduled_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/wa_green"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ③ Intervalo entre mensajes -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_container_low">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="⏱️  Intervalo entre mensajes"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:id="@+id/tv_interval_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 min"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/wa_green"/>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sb_interval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="59"
                        android:progress="1"
                        android:progressTint="@color/wa_green"
                        android:thumbTint="@color/wa_green"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="1 min"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="60 min"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_duration_estimate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ④ Selección de contactos -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_container_low">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👥  Contactos destinatarios"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp"/>

                    <!-- Tabs de modo selección -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tab_contact_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tabMode="scrollable"
                        app:tabGravity="start"
                        app:tabSelectedTextColor="@color/wa_green"
                        app:tabIndicatorColor="@color/wa_green"/>

                    <!-- Selector dinámico (cambia según el tab) -->
                    <Spinner
                        android:id="@+id/spinner_filter"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"/>

                    <Button
                        android:id="@+id/btn_select_contacts"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Seleccionar contactos manualmente"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                    <Button
                        android:id="@+id/btn_import_numbers"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="📂 Importar desde archivo (CSV/TXT)"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                    <!-- Resumen de contactos seleccionados -->
                    <TextView
                        android:id="@+id/tv_contacts_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 contactos seleccionados"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/wa_green"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ⑤ WhatsApp a usar -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_container_low">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱  Enviar desde"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp"/>

                    <RadioGroup
                        android:id="@+id/rg_wa_app"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rb_wa_business_send"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="🏪  WhatsApp Business"
                            android:textSize="14sp"
                            android:checked="true"
                            android:gravity="center_vertical"/>

                        <RadioButton
                            android:id="@+id/rb_wa_personal_send"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="📱  WhatsApp Personal"
                            android:textSize="14sp"
                            android:gravity="center_vertical"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón principal: Iniciar -->
            <Button
                android:id="@+id/btn_start_campaign"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="🚀  Iniciar Campaña"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/wa_green"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
