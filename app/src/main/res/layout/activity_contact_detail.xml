<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/wa_green"
            app:titleTextColor="@color/white"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ID Badge -->
            <TextView
                android:id="@+id/tv_contact_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="abril2026_001"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="20dp"/>

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMBRE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Nombre del contacto"
                android:background="@color/surface_container_low"
                android:paddingHorizontal="12dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp"/>

            <!-- Estado / Etiqueta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTADO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"/>
            </HorizontalScrollView>

            <!-- Teléfono (solo lectura) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TELÉFONO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/tv_phone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/surface_container_low"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp"/>

            <!-- Tipo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIPO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/tv_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WhatsApp Business"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp"/>

            <!-- Grupo/Mes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GRUPO / MES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/tv_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp"/>

            <!-- Notas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTAS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/et_notes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Añadir nota…"
                android:background="@color/surface_container_low"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:layout_marginBottom="28dp"/>

            <!-- Botón Guardar -->
            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Guardar cambios"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:backgroundTint="@color/wa_green"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Botón Abrir WhatsApp -->
            <Button
                android:id="@+id/btn_open_whatsapp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Abrir en WhatsApp"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/wa_green"
                android:textColor="@color/white"
                android:drawableStart="@drawable/ic_whatsapp"
                android:drawablePadding="8dp"
                android:layout_marginBottom="12dp"/>

            <!-- Botón Eliminar -->
            <Button
                android:id="@+id/btn_delete"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Eliminar contacto"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:backgroundTint="@color/error_color"
                android:textColor="@color/white"
                android:layout_marginBottom="32dp"/>

            <!-- Sección de Agenda -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GESTIÓN DE PEDIDOS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/wa_green"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_agendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Agendar Pedido"
                android:textColor="@color/white"
                android:backgroundTint="@color/wa_green" />

            <LinearLayout
                android:id="@+id/container_pedidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">
                <!-- Los pedidos se cargarán dinámicamente -->
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
